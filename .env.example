# Admin panel (Keystatic) in production — edits are committed to GitHub.
# Leave unset in development: the panel then writes straight to local files.
NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# Filled in by the GitHub App setup flow at /keystatic on the deployed site.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Public address of the deployed site (canonical links, sitemap, social cards).
NEXT_PUBLIC_SITE_URL=https://example.com

# Order form (/api/order) — set either or both. Without them the form still
# works: visitors get a ready-made email / Telegram message instead.
# Telegram: create a bot with @BotFather, send it a message, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# n8n: a Webhook node's production URL; receives the request as JSON.
N8N_WEBHOOK_URL=
