# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills: keep the ones this project uses; the rest restore from skills-lock.json
/.claude/skills/*
!/.claude/skills/ui-ux-pro-max/
!/.claude/skills/web-design-guidelines/
!/.claude/skills/vercel-react-best-practices/
!/.claude/skills/threejs/
!/.claude/skills/gsap/
!/.claude/skills/cinematic-gsap-lenis-motion-system/
!/.claude/skills/tailwindcss/

!.env.example
